NODE_ENV=development
HOST=127.0.0.1
PORT=4174
CLIENT_ORIGIN=http://127.0.0.1:5500
PUBLIC_SERVER_URL=http://127.0.0.1:4174

# `memory` runs the complete local demo without external services.
# Use `mongo` for persistent production/development storage.
DATABASE_MODE=memory
MONGODB_URI=mongodb://127.0.0.1:27017/healthguard
MONGODB_DB_NAME=healthguard

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
OCR_PROVIDER=disabled
OCR_API_URL=
OCR_API_KEY=
AI_PROVIDER=disabled
AI_API_URL=
AI_API_KEY=
AI_MODEL=
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@healthguard.local
MAPS_PROVIDER=external-link

# Development-only controls. Never enable seed credentials in production.
ENABLE_DEMO_ACCOUNT=true
DEMO_USER_EMAIL=demo@healthguard.local
DEMO_USER_PASSWORD=HealthGuard!2026
DEMO_ADMIN_EMAIL=admin@healthguard.local
DEMO_ADMIN_PASSWORD=HealthGuardAdmin!2026
DEMO_DRIVER_EMAIL=driver@healthguard.local
DEMO_DRIVER_PASSWORD=HealthGuardDriver!2026
